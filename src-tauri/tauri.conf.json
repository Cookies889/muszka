{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muszka",
  "version": "0.1.0",
  "identifier": "pl.muszka.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5176",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Muszka",
        "url": "index.html",
        "width": 1040,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "backgroundColor": "#141614"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Muszka",
    "windows": {
      "nsis": {
        "languages": [
          "Polish"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBMDI0RUNCRTk3NTEwQTgKUldTb0VIWHB5MDRDdWdvN2ZSaklNL09ZWG1CdndSNXFPSTBEWW55cVZ2N3JjOCtoSzk1Y1RQN0IK",
      "endpoints": [
        "https://github.com/Cookies889/muszka/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
